LOCALGATE_HOST=127.0.0.1
LOCALGATE_PORT=8400
LOCALGATE_OLLAMA_BASE_URL=http://localhost:11434
LOCALGATE_OLLAMA_MODEL=gemma4:e2b
# Local chain-of-thought: off by default for speed; can be overridden per /generate request.
LOCALGATE_OLLAMA_THINK=false
# Context window in tokens. Pinned rather than inherited: Ollama's default varies with
# available VRAM and it trims over-long prompts from the front without reporting it, so an
# unset window makes results depend on the machine. Recorded per generation as prompt_tokens.
LOCALGATE_OLLAMA_NUM_CTX=8192

LOCALGATE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LOCALGATE_CLASSIFIER_THRESHOLD=0.05

# The database defaults to ~/.localgate/localgate.sqlite.
# Set LOCALGATE_DB_PATH to an absolute path to use another location.
LOCALGATE_ENABLE_ENERGY=false

# Cloud model the avoided-cloud estimate compares against (must be EcoLogits-supported).
LOCALGATE_CLOUD_REFERENCE_PROVIDER=openai
LOCALGATE_CLOUD_REFERENCE_MODEL=gpt-5.4-2026-03-05
# Grid zone (ISO-3) for carbon; WOR = world average. Set your country (e.g. DEU) for a
# location-specific comparison. Affects carbon only, not energy.
LOCALGATE_ENERGY_GRID_ZONE=WOR

LOCALGATE_LOG_LEVEL=INFO
